      "sha256": "6e4d26b4e8618a8f217678c59ebe0fcbfa75cc14f3f7ece2ae91bc7ade0c1a5a",
      "title": "Bound tiffcrop's debug sample dump loop",
      "description": "Bounds the debug output loop to the MAX_SAMPLES capacity of srcbuffs.",
      "cves": [
        "CVE-2025-61144"
      ],
      "upstream": {
        "repository": "https://gitlab.com/libtiff/libtiff",
        "commit": "88cf9dbb48f6e172629795ecffae35d5052f68aa",
