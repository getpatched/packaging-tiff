        "forwarded": "not-needed (applied upstream)",
        "lastUpdate": "2026-10-30"
      },
      "tests": [
        {
          "id": "tiffcrop-debug-sample-bounds",
          "runner": "getpatched/platform:verification/regression.py",
          "fixtures": [
            {
              "path": "tests/fixtures/multisample.tif",
              "sha256": "cc4525fd8ba32458b14d7bcde172a9c5cf3ae98a9629f2f1f1e09a93cc775872"
            }
          ],
          "baselineExpectation": "Valgrind reports the out-of-bounds srcbuffs access against the exact installed baseline package.",
          "patchedExpectation": "The installed patched tiffcrop completes the same debug dump and tiffinfo can read the output."
        }
      ]
