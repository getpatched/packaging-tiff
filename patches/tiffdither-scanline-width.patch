Description: Reject tiffdither rows wider than the allocated scanline
 The input image width is checked against its decoded row size before the
 dithering loop reads pixels, preventing an invalid scanline access.
Origin: upstream, https://gitlab.com/libtiff/libtiff/-/commit/4d28af5fe61b1760f10981f5072ff1e6fd44f210
Forwarded: not-needed (applied upstream)
Last-Update: 2026-10-30
--- a/tools/tiffdither.c
+++ b/tools/tiffdither.c
@@ -87,6 +87,11 @@ static int fsdither(TIFF *in, TIFF *out)
         fprintf(stderr, "Out of memory.\n");
         goto skip_on_error;
     }
+    if (imagewidth > TIFFScanlineSize(in))
+    {
+        fprintf(stderr, "Image width exceeds scanline size.\n");
+        goto skip_on_error;
+    }

